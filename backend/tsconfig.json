{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "lib": ["ES2023"],
    "target": "ES2023",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "esModuleInterop": true,
    "types": ["node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
